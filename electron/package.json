{
  "name": "rasterform-desktop-tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:web": "npm --prefix .. run build",
    "build:runtime": "node ./scripts/build-runtime.mjs",
    "build:render": "vite build --config ./vite.render.config.ts",
    "icon:generate": "node ./scripts/generate-icon.mjs",
    "stage": "node ./scripts/stage.mjs",
    "build": "npm run build:web && npm run typecheck && npm run build:runtime && npm run build:render && npm run stage",
    "smoke": "npm run build && node ./scripts/smoke.mjs",
    "smoke:staged": "node ./scripts/smoke.mjs",
    "smoke:packaged": "npm run package && node ./scripts/smoke-packaged.mjs",
    "smoke:packaged:arm64": "npm run package:arm64 && npm run smoke:packaged:existing:arm64",
    "smoke:packaged:x64": "npm run package:x64 && npm run smoke:packaged:existing:x64",
    "smoke:packaged:universal": "npm run package:universal && npm run smoke:packaged:existing:universal",
    "smoke:packaged:existing:arm64": "node ./scripts/smoke-packaged.mjs arm64",
    "smoke:packaged:existing:x64": "node ./scripts/smoke-packaged.mjs x64",
    "smoke:packaged:existing:universal": "node ./scripts/smoke-packaged.mjs universal",
    "verify:packaged:arm64": "node ./scripts/verify-package.mjs ./out/Rasterform-darwin-arm64/Rasterform.app",
    "verify:packaged:x64": "node ./scripts/verify-package.mjs ./out/Rasterform-darwin-x64/Rasterform.app",
    "verify:packaged:universal": "node ./scripts/verify-package.mjs ./out/Rasterform-darwin-universal/Rasterform.app",
    "start": "electron ./.stage",
    "dev": "npm run build && npm run start",
    "package": "npm run build && node ./scripts/package.mjs",
    "package:arm64": "npm run build && node ./scripts/package.mjs arm64",
    "package:x64": "npm run build && node ./scripts/package.mjs x64",
    "package:universal": "npm run build && node ./scripts/package.mjs universal",
    "package:all": "npm run build && node ./scripts/package.mjs arm64 x64 universal"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.0.4",
    "electron": "43.3.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
