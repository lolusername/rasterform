{
  "name": "rasterform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "desktop:dev": "npm --prefix electron run dev",
    "desktop:check": "npm --prefix electron run typecheck",
    "desktop:test": "vitest run src/desktop electron",
    "desktop:build": "npm --prefix electron run build",
    "desktop:smoke": "npm --prefix electron run smoke",
    "desktop:smoke:packaged": "npm --prefix electron run smoke:packaged",
    "desktop:smoke:packaged:arm64": "npm --prefix electron run smoke:packaged:arm64",
    "desktop:smoke:packaged:x64": "npm --prefix electron run smoke:packaged:x64",
    "desktop:package": "npm --prefix electron run package",
    "desktop:package:arm64": "npm --prefix electron run package:arm64",
    "desktop:package:x64": "npm --prefix electron run package:x64",
    "desktop:package:universal": "npm --prefix electron run package:universal",
    "desktop:package:all": "npm --prefix electron run package:all",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "d3-contour": "^4.0.2",
    "three": "^0.180.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.11",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.0.0"
  }
}
